import java.util.Scanner;

public class Exercicio03 {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.println("Digite o números de matrículas que serão inseridas em Programação Modular: ");
        int n = scanner.nextInt();
        int[] pmodular = new int[n];

        System.out.println("Digite as matrículas: ");
        for (int i = 0; i < n; i++) {
            pmodular[i] = scanner.nextInt();
            System.out.println("restantes: " + (pmodular.length - i - 1));

        }

        System.out.println("Digite o números de matrículas que serão inseridas em Cálculo 1: ");
        n = scanner.nextInt();
        int[] calculo1 = new int[n];

        System.out.println("Digite as matrículas: ");
        for (int i = 0; i < n; i++) {
            calculo1[i] = scanner.nextInt();
            System.out.println("restantes: " + (calculo1.length - i - 1));

        }

        System.out.println("===== ALUNOS NAS DUAS DISCIPLINAS =====");
        for (int p = 0; p < pmodular.length; p++) {
            for (int c = 0; c < calculo1.length; c++) {
                if (pmodular[p] == calculo1[c]) {
                    System.out.println(pmodular[p]);
                }
            }
        }
    }
}
